rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return verified() && request.auth.token.email == 'danrabbit333@gmail.com'; }
    function mine() { return request.resource.data.authorID == request.auth.uid; }
    function owner() { return request.auth != null && resource.data.authorID == request.auth.uid; }
    function isMember(gid) { return request.auth != null && exists(/databases/$(db)/documents/groups/$(gid)/members/$(request.auth.uid)); }

    match /sightings/{id} {
      allow read: if true;
      allow create: if verified() && mine() && request.resource.data.title.size() <= 80 && request.resource.data.details.size() <= 1000;
      allow delete: if owner() || isAdmin();
    }
    match /photos/{id} {
      allow read: if true;
      allow create: if verified() && mine() && request.resource.data.data.size() < 800000;
      allow delete: if owner() || isAdmin();
    }
    match /threads/{id} {
      allow read: if true;
      allow create: if verified() && mine() && request.resource.data.title.size() <= 100 && request.resource.data.body.size() <= 2000;
      allow delete: if owner() || isAdmin();
      match /posts/{pid} {
        allow read: if true;
        allow create: if verified() && mine() && request.resource.data.text.size() <= 2000;
        allow delete: if owner() || isAdmin();
      }
    }
    match /groups/{gid} {
      allow read: if isMember(gid) || owner() || isAdmin() || resource.data.private == false;
      allow create: if verified() && mine() && request.resource.data.private is bool && request.resource.data.name.size() <= 60 && request.resource.data.description.size() <= 500;
      allow delete: if owner() || isAdmin();
      match /members/{uid} {
        allow read: if request.auth != null && (isMember(gid) || isAdmin() || get(/databases/$(db)/documents/groups/$(gid)).data.private == false);
        allow create: if verified() && request.auth.uid == uid && request.resource.data.name.size() <= 30 && exists(/databases/$(db)/documents/groups/$(gid));
        allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin() || get(/databases/$(db)/documents/groups/$(gid)).data.authorID == request.auth.uid);
      }
      match /messages/{mid} {
        allow read: if isMember(gid) || isAdmin();
        allow create: if verified() && mine() && isMember(gid) && request.resource.data.text.size() <= 1000;
        allow delete: if owner() || isAdmin();
      }
      match /files/{mid} {
        allow read: if isMember(gid) || isAdmin();
        allow create: if verified() && mine() && isMember(gid) && request.resource.data.data.size() < 950000;
        allow delete: if owner() || isAdmin();
      }
    }
    match /users/{uid}/memberships/{gid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /reports/{id} {
      allow create: if request.auth != null;
      allow read, delete: if isAdmin();
    }
  }
}
