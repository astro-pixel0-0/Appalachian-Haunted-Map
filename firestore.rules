rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // banned accounts (bans/{uid}: forever or until a time set by the admin) lose all write access
    function banned() { let b = /databases/$(db)/documents/bans/$(request.auth.uid); return exists(b) && (get(b).data.forever == true || get(b).data.until > request.time); }
    // signed in with a verified email (used for reading: the site is members-only)
    function member() { return request.auth != null && request.auth.token.email_verified == true; }
    function verified() { return request.auth != null && request.auth.token.email_verified == true && !banned(); }
    function isAdmin() { return verified() && request.auth.token.email == 'danrabbit333@gmail.com'; }
    function mine() { return request.resource.data.authorID == request.auth.uid; }
    function owner() { return request.auth != null && resource.data.authorID == request.auth.uid; }
    function isMember(gid) { return request.auth != null && exists(/databases/$(db)/documents/groups/$(gid)/members/$(request.auth.uid)); }

    match /sightings/{id} {
      allow read: if member();
      allow create: if verified() && mine() && request.resource.data.title.size() <= 80 && request.resource.data.details.size() <= 1000
        && (!('priv' in request.resource.data) || request.resource.data.priv == true)
        && (isAdmin() || (request.resource.data.lat >= 30.0 && request.resource.data.lat <= 45.1 && request.resource.data.lon >= -91.7 && request.resource.data.lon <= -71.7));
      allow delete: if owner() || isAdmin();
    }
    match /photos/{id} {
      allow read: if member();
      allow create: if verified() && mine() && request.resource.data.data.size() < 800000;
      allow delete: if owner() || isAdmin();
    }
    match /threads/{id} {
      allow read: if member();
      allow create: if verified() && mine() && request.resource.data.title.size() <= 100 && request.resource.data.body.size() <= 2000
        && (!('tag' in request.resource.data) || request.resource.data.tag in ['general', 'sightings', 'expeditions', 'evidence', 'legends', 'abandoned', 'offtopic']);
      allow delete: if owner() || isAdmin();
      match /posts/{pid} {
        allow read: if member();
        allow create: if verified() && mine() && request.resource.data.text.size() <= 2000;
        allow delete: if owner() || isAdmin();
      }
    }
    match /groups/{gid} {
      allow get: if member() && (isMember(gid) || owner() || isAdmin() || resource.data.private == false);
      allow list: if member() && (isAdmin() || resource.data.private == false);
      allow create: if verified() && mine() && request.resource.data.private is bool && request.resource.data.name.size() <= 60 && request.resource.data.description.size() <= 500;
      allow delete: if owner() || isAdmin();
      match /members/{uid} {
        allow read: if request.auth != null && (isMember(gid) || isAdmin() || get(/databases/$(db)/documents/groups/$(gid)).data.private == false);
        allow create: if verified() && request.auth.uid == uid && request.resource.data.name.size() <= 30 && exists(/databases/$(db)/documents/groups/$(gid));
        allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin() || get(/databases/$(db)/documents/groups/$(gid)).data.authorID == request.auth.uid);
      }
      match /messages/{mid} {
        allow read: if isMember(gid) || isAdmin();
        allow create: if verified() && mine() && isMember(gid) && request.resource.data.text.size() <= 1000;
        allow delete: if owner() || isAdmin();
      }
      match /files/{mid} {
        allow read: if isMember(gid) || isAdmin();
        allow create: if verified() && mine() && isMember(gid) && request.resource.data.data.size() < 950000;
        allow delete: if owner() || isAdmin();
      }
    }
    // a has blocked b
    function blockedBy(a, b) { return exists(/databases/$(db)/documents/users/$(a)/blocks/$(b)); }
    function isFriend(a, b) { return exists(/databases/$(db)/documents/users/$(a)/friends/$(b)); }
    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'nameLower', 'bio', 'avatar', 'banner', 'frame', 'bg', 'pbg', 'links', 'vis', 'admin', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && (!('nameLower' in d) || d.nameLower == d.name.lower())
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
        && (!('avatar' in d) || (d.avatar is string && d.avatar.size() < 200000 && d.avatar.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && (!('banner' in d) || (d.banner is string && d.banner.size() < 450000 && d.banner.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')))
        && (!('frame' in d) || d.frame in ['none', 'frost', 'sage', 'blood', 'steel', 'spectral', 'bone', 'rust', 'moss', 'violet', 'ember', 'gold', 'ice', 'toxic', 'ghost', 'checker', 'hazard', 'barbed', 'circuit', 'static', 'bloodpulse', 'aurora', 'double', 'royal', 'moth', 'embers', 'neon', 'prism', 'signal', 'siren', 'candle', 'mist', 'storm', 'gilded', 'ecto', 'tape', 'marquee', 'void', 'comet', 'frostbite'])
        && (!('pbg' in d) || d.pbg in ['graphite', 'night', 'fog', 'forest', 'ghosts', 'moths', 'eyes', 'crosses', 'bricks', 'planks', 'circuit', 'crt', 'noise', 'checker', 'topo', 'bloodrain', 'moss', 'fireflies', 'snow', 'leaves', 'sigils', 'ufos', 'paws', 'quilt', 'damask', 'rain', 'a_snow', 'a_rain', 'a_embers', 'a_stars', 'a_fog', 'a_ghosts', 'a_code', 'a_blood', 'a_leaves', 'a_fireflies', 'a_ufos', 'a_moths', 'a_waves', 'a_scan'])
        && (!('bg' in d) || d.bg in ['', 'ridge', 'bloodmoon', 'hollow', 'stars', 'pines', 'graveyard', 'farm', 'bridge', 'mine', 'swamp', 'aurora', 'storm', 'corn', 'tower', 'tunnel', 'church', 'cabin', 'ufo', 'lake', 'snow', 'autumn', 'dawn', 'static', 'terminal', 'ecto', 'a_snowfall', 'a_rain', 'a_aurora', 'a_fireflies', 'a_ufo', 'a_campfire', 'a_meteor', 'a_fog', 'a_mothman', 'a_beacon', 'a_lake', 'a_static', 'a_terminal', 'a_bats'])
        && (!('links' in d) || (d.links is map && d.links.size() <= 8))
        && (!('vis' in d) || d.vis in ['all', 'friends', 'nobody'])
        && (!('admin' in d) || (d.admin == true && isAdmin()));
    }
    match /users/{uid} {
      allow read: if member();
      allow create, update: if verified() && request.auth.uid == uid && validProfile();
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    // personal block list: only the owner (and admin) can see it
    match /users/{uid}/blocks/{bid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if verified() && request.auth.uid == uid && bid != uid;
    }
    match /users/{uid}/friends/{fid} {
      allow read: if request.auth != null;
      allow create: if verified() && request.resource.data.name is string && request.resource.data.name.size() <= 30 && (
        !blockedBy(uid, fid) && !blockedBy(fid, uid) && (
        (request.auth.uid == uid && exists(/databases/$(db)/documents/requests/$(uid)/in/$(fid))) ||
        (request.auth.uid == fid && exists(/databases/$(db)/documents/requests/$(fid)/in/$(uid)))));
      allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == fid || isAdmin());
    }
    match /requests/{to}/in/{from} {
      allow read: if request.auth != null && (request.auth.uid == to || request.auth.uid == from);
      allow create: if verified() && request.auth.uid == from && from != to && !blockedBy(to, from) && !blockedBy(from, to) && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if request.auth != null && (request.auth.uid == to || request.auth.uid == from);
    }
    match /private/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['email']) && request.resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /users/{uid}/memberships/{gid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // HAUNT card game tables (casual: any seated player may update the shared game state)
    match /haunt/{rid} {
      allow read: if request.auth != null;
      allow create: if verified() && request.resource.data.host == request.auth.uid && request.resource.data.players == [request.auth.uid];
      allow update: if verified() && (request.auth.uid in resource.data.players
        || (resource.data.status == 'lobby' && request.auth.uid in request.resource.data.players
            && request.resource.data.players.size() == resource.data.players.size() + 1 && request.resource.data.players.size() <= 4));
      allow delete: if request.auth != null && (resource.data.host == request.auth.uid || isAdmin());
    }
    match /hinv/{to}/in/{rid} {
      allow read, delete: if request.auth != null && (request.auth.uid == to || resource.data.fromUid == request.auth.uid);
      allow create: if verified() && request.resource.data.fromUid == request.auth.uid && to != request.auth.uid
        && isFriend(to, request.auth.uid) && !blockedBy(to, request.auth.uid);
    }
    // online status: the owner chooses who sees it (everyone / friends / nobody); blocked users never see it
    match /presence/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || (!blockedBy(uid, request.auth.uid) && (
        !('vis' in resource.data) || resource.data.vis == 'all' || (resource.data.vis == 'friends' && isFriend(uid, request.auth.uid)))));
      allow write: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['t', 'off', 'vis'])
        && (!('vis' in request.resource.data) || request.resource.data.vis in ['all', 'friends', 'nobody']);
    }
    // shared location: visible only to the user themself and the admin
    // location shared with friends: the owner lists exactly who may see it (their friends); approximate if they chose so
    match /friendloc/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin() || request.auth.uid in resource.data.to);
      allow create, update: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['lat', 'lng', 'fuzz', 'name', 'to', 't'])
        && request.resource.data.lat is number && request.resource.data.lng is number && request.resource.data.fuzz is bool
        && request.resource.data.to is list && request.resource.data.to.size() <= 200;
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /userloc/{uid} {
      allow read: if verified() && (request.auth.uid == uid || isAdmin());
      allow write: if verified() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['lat', 'lng', 'acc', 'name', 't'])
        && request.resource.data.lat is number && request.resource.data.lng is number;
      allow delete: if verified() && (request.auth.uid == uid || isAdmin());
    }
    // exact location of a stream / a report with a hidden spot: only the author writes it, only the admin reads it
    match /exact/{id} {
      allow read: if isAdmin();
      allow create, update: if verified() && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'owner', 'lat', 'lng', 'path', 'ended', 'endedAt']) && request.resource.data.kind in ['stream', 'sighting']
        && (!('path' in request.resource.data) || (request.resource.data.path is list && request.resource.data.path.size() <= 600))
        && request.resource.data.lat is number && request.resource.data.lng is number
        && (resource == null || resource.data.owner == request.auth.uid);
      allow delete: if request.auth != null && (isAdmin() || resource.data.owner == request.auth.uid);
    }
    // admin's location view log: append-only (nobody can edit or delete it from the site)
    match /adminlog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['at', 'kind', 'target', 'name', 'ref'])
        && request.resource.data.at == request.time && request.resource.data.kind in ['me', 'stream', 'sighting'];
      allow update, delete: if false;
    }
    // live streams: WebRTC signalling (peers) + stream chat
    match /streams/{sid} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.owner == request.auth.uid && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.lat is number && request.resource.data.lng is number && request.resource.data.live == true
        && (!('aud' in request.resource.data) || request.resource.data.aud in ['all', 'friends'])
        && (isAdmin() || (request.resource.data.lat >= 30.0 && request.resource.data.lat <= 45.1 && request.resource.data.lng >= -91.7 && request.resource.data.lng <= -71.7));
      // the owner updates their stream until the admin ends it; the admin can end any stream for good (killed)
      allow update: if verified() && (
        (resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner
          && resource.data.get('killed', false) != true && request.resource.data.get('killed', false) != true)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['live', 'killed', 'endedAt'])
          && request.resource.data.live == false && request.resource.data.killed == true));
      allow delete: if verified() && (resource.data.owner == request.auth.uid || isAdmin());
      match /peers/{vid} {
        allow read, update: if verified() && (request.auth.uid == vid || get(/databases/$(db)/documents/streams/$(sid)).data.owner == request.auth.uid);
        allow create: if verified() && request.auth.uid == vid && request.resource.data.offer is string && request.resource.data.offer.size() < 20000
          && !blockedBy(get(/databases/$(db)/documents/streams/$(sid)).data.owner, vid)
          && (get(/databases/$(db)/documents/streams/$(sid)).data.get('aud', 'all') != 'friends' || isAdmin()
              || isFriend(get(/databases/$(db)/documents/streams/$(sid)).data.owner, vid));
        allow delete: if verified() && (request.auth.uid == vid || get(/databases/$(db)/documents/streams/$(sid)).data.owner == request.auth.uid || isAdmin());
      }
      match /chat/{mid} {
        allow read: if verified();
        allow create: if verified() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300 && request.resource.data.name.size() <= 30;
        allow delete: if verified() && (resource.data.uid == request.auth.uid || isAdmin() || get(/databases/$(db)/documents/streams/$(sid)).data.owner == request.auth.uid);
      }
    }
    // bans: the user can see their own ban; only the admin sets or lifts them
    match /bans/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin() && request.auth.uid != uid;
    }
    // accounts waiting 48 h for deletion (restorable by signing in)
    match /deletion/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['at', 'name', 'email', 'profile']);
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /reports/{id} {
      allow create: if request.auth != null;
      allow read, delete: if isAdmin();
    }
  }
}
